{
    "version": "2.0.0",
    "options": {
        "env": {
            "PYTHONPATH": "${workspaceFolder}",
            "LOG_LEVEL": "DEBUG",
            "KBE_LOGINAPP_HOST": "localhost",
            "KBE_LOGINAPP_TCP_PORT": "20013",
            "GAME_ACCOUNT_NAME": "1",
            "GAME_PASSWORD": "1",
            "KBE_MACHINE_HOST": "0.0.0.0",
            "KBE_MACHINE_TCP_PORT": "20099",
        }
    },
    "tasks": [
        {
            "label": "[enki] Unit tests",
            "type": "shell",
            "command": "${config:python.pytest}",
            "args": [
                "${workspaceFolder}/tests/utests",
                "--disable-warnings"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true
            },
            "problemMatcher": []
        },
        {
            "label": "[enki] Integration tests",
            "type": "shell",
            "command": "${config:python.pytest}",
            "args": [
                "${workspaceFolder}/tests/itests",
                "-o log_cli=true",
                "--log-cli-level=DEBUG",
                "--disable-warnings"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true
            },
            "problemMatcher": []
        },
        {
            "label": "[Enki] Show package graph",
            "type": "shell",
            "command": "/home/leto/.local/share/virtualenvs/enki-AEzvoHOr/bin/pyreverse --output png --project EnkiCore --output-directory \"/home/leto/2PeopleCompany/WORKLOG/20250619 [enki] Обновить архитектуру Enki\" /home/leto/2PeopleCompany/REPOS/enki/enki/apps/clientapp/entity_sub_system/ientity_serializer.py && eom \"/home/leto/2PeopleCompany/WORKLOG/20250619 [enki] Обновить архитектуру Enki/ientity_serializer.py.png\"",
            "args": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
