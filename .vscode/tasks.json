                "focus": true
            },
            "problemMatcher": []
        },
        {
            "label": "[Ruff] Format the project",
            "type": "shell",
            "command": "$RUFF_PATH check --line-length=88 --extend-select I --fix --unsafe-fixes enki/ tools/ tests/ --exclude tests/data",
            "args": [],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "RUFF_PATH": "/home/leto/.local/share/virtualenvs/enki-YNQB7YYz/bin/ruff",
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
