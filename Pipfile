[[source]]
name = "pypi"
url = "https://pypi.org/simple"
verify_ssl = true

[dev-packages]
ipykernel = "*"
pytest = "*"

[packages]
environs = "*"
Jinja2 = "*"
xmltodict = "*"
debugpy = "*"
pyperclip = "*"
lxml = "*"
lxml-stubs = "*"
python-dateutil = "*"

[requires]
python_version = "3.13"

[scripts]
supervisor = "bash -c 'python enki/apps/supervisor'"
lookApp_machine = "bash -c 'LOG_LEVEL=INFO python tools/cmd/machine/lookApp.py'"
onFindInterfaceAddr = "bash -c 'LOG_LEVEL=INFO python tools/cmd/machine/onFindInterfaceAddr.py'"
onQueryAllInterfaceInfos = "bash -c 'LOG_LEVEL=INFO python tools/cmd/machine/onQueryAllInterfaceInfos.py'"
queryComponentID = "bash -c 'LOG_LEVEL=INFO python tools/cmd/machine/queryComponentID.py'"
reqCloseServer = "bash -c 'LOG_LEVEL=INFO python tools/cmd/common/reqCloseServer.py'"
login = "bash -c 'LOG_LEVEL=INFO python tools/cmd/loginapp/login.py'"

kill_msgreader = "bash -c \"kill -s 7 $(ps aux | grep 'python tools/msgreader' | grep -v grep | awk '{print $2}')\""
